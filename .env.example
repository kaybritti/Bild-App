# ── Öffentliche Werte (.env, im Git-Repository) ─────────────────────────────

# n8n-Webhook, an den die Serverfunktion api/generate.ts die Bilder weiterleitet (nur serverseitig).
# Test-URL:       https://<dein-n8n>/webhook-test/<id>  (nur während eines aktiven Testlaufs)
# Produktion-URL: https://<dein-n8n>/webhook/<id>       (Workflow muss aktiviert sein)
N8N_WEBHOOK_URL=https://britta-ai.app.n8n.cloud/webhook/7c23bad7-e1fc-46b6-8ef3-0b15592524a9

# Supabase (Login): Projekt-URL und Publishable Key (Dashboard → Project Settings → API Keys).
# Beide Werte sind öffentlich – niemals den Secret- bzw. Service-Role-Key eintragen.
VITE_SUPABASE_URL=https://vboojmnviogfrdjymmgv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5dPt4f10cdYgxqdwvZ_erA_qiCHJh6v

# Cloudflare Turnstile (CAPTCHA bei Login, Registrierung und Passwort-Mails): öffentlicher Site Key.
# Leer = kein CAPTCHA. Zuerst hier setzen und deployen, dann in Supabase aktivieren (siehe README).
VITE_TURNSTILE_SITE_KEY=

# ── Geheime Werte (.env.local bzw. Vercel → Settings → Environment Variables) ─

# Supabase Secret API Key (sb_secret_...) oder Legacy Service-Role-JWT. Nur serverseitig!
# Erforderlich für die Nutzungslimits (supabase/migrations/202610200001_generation_limits.sql).
SUPABASE_SECRET_KEY=

# n8n-Zugangsdaten: je nach „Authentication“ im n8n-Webhook-Knoten EINE der beiden Varianten ausfüllen.

# Variante A – Header Auth: Name und Wert des Headers aus dem n8n-Credential
N8N_AUTH_HEADER_NAME=
N8N_AUTH_HEADER_VALUE=

# Variante B – Basic Auth: Benutzer und Passwort aus dem n8n-Credential
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# Stripe (Abo): Secret Key oder besser ein Restricted Key (rk_...) aus Stripe → Entwickler → API-Schlüssel.
# Restricted Key braucht Schreibrechte für Customers, Checkout Sessions und Customer Portal
# sowie Leserechte für Prices und Subscriptions. Sandbox: sk_test_/rk_test_, Livebetrieb: sk_live_/rk_live_.
STRIPE_SECRET_KEY=
# Signing Secret des Webhook-Endpunkts …/api/stripe-webhook (whsec_...). Lokal: Ausgabe von `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Optional: feste App-Adresse für die Rücksprung-URLs aus Stripe (z. B. https://deine-app.vercel.app).
# Leer = Adresse der aktuellen Anfrage.
APP_URL=
