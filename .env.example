# n8n-Webhook, an den die beiden Bilder (Bild1, Bild2) gesendet werden.
# Test-URL:       https://<dein-n8n>/webhook-test/<id>  (nur während eines aktiven Testlaufs)
# Produktion-URL: https://<dein-n8n>/webhook/<id>       (Workflow muss aktiviert sein)
# Hinweis: VITE_-Variablen sind im Browser sichtbar – hier keine Geheimnisse eintragen.
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/your-webhook-id
